<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    
    <!-- Security and Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    
    <!-- Assembly Info -->
    <AssemblyName>YourApp</AssemblyName>
    <RootNamespace>YourApp</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Your Company</Authors>
    <Description>Secure .NET Application</Description>
  </PropertyGroup>

  <!-- NuGet Package References -->
  <ItemGroup>
    <!-- Web Framework -->
    <PackageReference Include="Microsoft.AspNetCore.App" Version="8.0.*" />
    
    <!-- Logging -->
    <PackageReference Include="Serilog" Version="3.1.*" />
    <PackageReference Include="Serilog.AspNetCore" Version="8.1.*" />
    <PackageReference Include="Serilog.Sinks.Console" Version="5.1.*" />
    
    <!-- Dependency Injection -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.*" />
    
    <!-- Data Access -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.*" />
    
    <!-- Security -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.0.*" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.0.*" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.*" />
    
    <!-- Validation -->
    <PackageReference Include="FluentValidation" Version="11.8.*" />
    
    <!-- Monitoring -->
    <PackageReference Include="OpenTelemetry" Version="1.7.*" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" Version="1.7.*" />
  </ItemGroup>

  <!-- Test Project References -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.*" />
    <PackageReference Include="xunit" Version="2.6.*" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.*" />
    <PackageReference Include="Moq" Version="4.20.*" />
    <PackageReference Include="FluentAssertions" Version="6.12.*" />
  </ItemGroup>

</Project>
