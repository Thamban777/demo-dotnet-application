# ============================================================================
# Multi-stage Docker build for .NET 8 application
# Stage 1: Build and test
# Stage 2: Runtime
# ============================================================================

# ============================================================================
# STAGE 1: BUILDER - Build and test the application
# ============================================================================
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS builder

WORKDIR /src

# Copy solution and project files
COPY ["DemoDotnetApplication.sln", ""]
COPY ["DemoDotnetApplication/DemoDotnetApplication.csproj", "DemoDotnetApplication/"]
COPY ["DemoDotnetApplication.Tests/DemoDotnetApplication.Tests.csproj", "DemoDotnetApplication.Tests/"]

# Restore dependencies
RUN dotnet restore "DemoDotnetApplication.sln"

# Copy entire source code
COPY . .

# Build the application
RUN dotnet build "DemoDotnetApplication.sln" -c Release --no-restore

# Run unit tests (optional - comment out if tests fail in CI)
RUN dotnet test "DemoDotnetApplication.Tests/DemoDotnetApplication.Tests.csproj" \
    -c Release \
    --no-build \
    --verbosity normal \
    || true

# Publish the application
RUN dotnet publish "DemoDotnetApplication/DemoDotnetApplication.csproj" \
    -c Release \
    -o /app/publish \
    --no-build

# ============================================================================
# STAGE 2: RUNTIME - Final image with only runtime dependencies
# ============================================================================
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime

# Set working directory
WORKDIR /app

# Install curl for health checks (optional)
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy published application from builder stage
COPY --from=builder /app/publish .

# ============================================================================
# SECURITY: Create non-root user
# ============================================================================
# Running as root is a security risk
# Create dedicated application user
RUN useradd -m -u 1001 -s /bin/bash appuser && \
    chown -R appuser:appuser /app

# Switch to non-root user
USER appuser

# ============================================================================
# CONFIGURATION
# ============================================================================

# Expose port for application
EXPOSE 8080

# Set environment variables
ENV ASPNETCORE_URLS=http://+:8080 \
    ASPNETCORE_ENVIRONMENT=Production \
    DOTNET_RUNNING_IN_CONTAINER=true

# ============================================================================
# HEALTH CHECK
# ============================================================================
# Tells Docker and orchestration tools (Kubernetes) if the container is healthy
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# ============================================================================
# STARTUP
# ============================================================================
# Run the application
ENTRYPOINT ["dotnet", "DemoDotnetApplication.dll"]

# ============================================================================
# DOCKER BUILD LABELS
# ============================================================================
LABEL maintainer="Your Company"
LABEL description="Demo Dotnet Application with DevSecOps Pipeline"
LABEL version="1.0.0"
