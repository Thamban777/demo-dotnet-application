{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft": "Information",
      "Microsoft.Hosting.Lifetime": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "dev-secret-key-minimum-32-characters-for-local-development-testing!!",
    "Issuer": "YourApp-Dev",
    "Audience": "YourApp-Users-Dev",
    "ExpirationMinutes": 1440
  },
  "Database": {
    "ConnectionString": "Server=(localdb)\\mssqllocaldb;Database=YourAppDb;Integrated Security=true;TrustServerCertificate=true;"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5000",
      "http://localhost:5173",
      "http://127.0.0.1:*"
    ]
  },
  "Security": {
    "RequireHttps": false,
    "MaxRequestSize": 52428800,
    "ApiRateLimitPerMinute": 1000
  },
  "OpenTelemetry": {
    "Enabled": false,
    "SamplingRate": 0.1
  }
}
